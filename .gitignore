# Node
node_modules/
npm-debug.log*

# Env / secrets
.env
*.env.local

# Uploads (file storage lives outside version control)
backend/uploads/

# Flutter
mobile/**/build/
mobile/**/.dart_tool/
mobile/**/.flutter-plugins*
mobile/**/*.iml

# React
web/**/dist/
web/**/build/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/

# Local Claude Code tooling
.claude/

# impeccable plugin's runtime cache (its committed config lives at
# .impeccable/live/config.json, tracked separately — this only ignores the
# hook.cache.json files it writes wherever it happens to run from)
**/.impeccable/hook.cache.json
